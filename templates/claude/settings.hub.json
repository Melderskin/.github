{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "PowerShell(git status)",
      "Bash(git status *)",
      "PowerShell(git status *)",
      "Bash(git diff)",
      "PowerShell(git diff)",
      "Bash(git diff *)",
      "PowerShell(git diff *)",
      "Bash(git log)",
      "PowerShell(git log)",
      "Bash(git log *)",
      "PowerShell(git log *)",
      "Bash(git show *)",
      "PowerShell(git show *)",
      "Bash(git branch)",
      "PowerShell(git branch)",
      "Bash(git branch *)",
      "PowerShell(git branch *)",
      "Bash(git fetch)",
      "PowerShell(git fetch)",
      "Bash(git fetch *)",
      "PowerShell(git fetch *)",
      "Bash(git worktree list)",
      "PowerShell(git worktree list)",
      "Bash(gh pr view *)",
      "PowerShell(gh pr view *)",
      "Bash(gh pr checks *)",
      "PowerShell(gh pr checks *)",
      "Bash(gh pr list *)",
      "PowerShell(gh pr list *)",
      "Bash(gh pr diff *)",
      "PowerShell(gh pr diff *)",
      "Bash(gh issue view *)",
      "PowerShell(gh issue view *)",
      "Bash(gh issue list *)",
      "PowerShell(gh issue list *)",
      "Bash(gh run list *)",
      "PowerShell(gh run list *)",
      "Bash(gh run view *)",
      "PowerShell(gh run view *)",
      "Bash(gh run watch *)",
      "PowerShell(gh run watch *)",
      "Bash(bash status-all.sh*)",
      "PowerShell(bash status-all.sh*)",
      "Bash(bash test-all.sh*)",
      "PowerShell(bash test-all.sh*)",
      "Bash(bash clone-all.sh*)",
      "PowerShell(bash clone-all.sh*)"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "PowerShell(gh pr merge *)",
      "Edit(./.github/workflows/**)",
      "Edit(./.githooks/**)",
      "Edit(./.claude/**)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets.json)",
      "Read(**/*.pfx)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(./.claude/settings.local.json)",
      "Bash(git push --force*)",
      "PowerShell(git push --force*)",
      "Bash(git push -f *)",
      "PowerShell(git push -f *)",
      "Bash(git push * --force*)",
      "PowerShell(git push * --force*)",
      "Bash(git push origin main*)",
      "PowerShell(git push origin main*)",
      "Bash(git reset --hard*)",
      "PowerShell(git reset --hard*)",
      "Bash(git commit --no-verify*)",
      "PowerShell(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "PowerShell(git commit * --no-verify*)",
      "Bash(gh secret *)",
      "PowerShell(gh secret *)",
      "Bash(gh repo delete *)",
      "PowerShell(gh repo delete *)",
      "Bash(gh release *)",
      "PowerShell(gh release *)",
      "Bash(rm -rf *)",
      "PowerShell(rm -rf *)",
      "Bash(printenv*)",
      "PowerShell(printenv*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|Grep|Glob|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.ps1\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}

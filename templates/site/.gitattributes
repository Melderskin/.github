# The same files on Windows, macOS and Linux: text is stored and checked out with LF line endings (as .editorconfig
# says), whatever core.autocrlf is set to. Shell scripts break with CRLF; PowerShell 7 reads LF scripts fine.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.mp4 binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
# Design files: some (EPS) look like text, so without this git would diff them and gitleaks would read them.
*.eps binary
*.ai binary
*.psd binary
*.sketch binary
*.zip binary
